def button_style(text):
    if text.startswith("🟢") or text.startswith("✅") or text.startswith("➕"):
        return "success"
    if text.startswith("🔴") or text.startswith("🗑") or text.startswith("❌"):
        return "danger"
    if text.startswith(("🔵","🧪","⚙️","🟡","👑","💳","📦","💾","📥","🔀","📅","👤","🔑","🛒","📊")):
        return "primary"
    return None

def markup(rows):
    out=[]
    for row in rows:
        rr=[]
        for item in row:
            text,data=item[:2]
            style=item[2] if len(item)>2 else button_style(text)
            kwargs={"callback_data":data}
            if style: kwargs["style"]=style
            rr.append(InlineKeyboardButton(text,**kwargs))
        out.append(rr)
    return InlineKeyboardMarkup(out)
