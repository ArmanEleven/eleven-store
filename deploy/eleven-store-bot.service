[Unit]
Description=Eleven Store License Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/eleven-store-bot
ExecStart=/opt/eleven-store-bot/.venv/bin/python /opt/eleven-store-bot/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
